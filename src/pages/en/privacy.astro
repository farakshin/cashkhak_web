---
import Layout from "../../components/Layout.astro";
import { privacySectionsEn } from "../../data/site-en";
---
<Layout lang="en" title="Privacy policy" currentPath="/en/privacy.html"><section class="page-hero section-shell"><div class="shell narrow-shell"><p class="eyebrow"><span class="eyebrow-dot"></span> Cashkhak</p><h1>Privacy<br /><em>policy.</em></h1><p class="page-lede">Last updated: August 18, 2026</p></div></section><section class="section-shell page-content"><div class="shell legal-shell"><p class="legal-intro">Cashkhak is a local tool for keeping track of cashback categories. We try to collect as little data as possible — ideally none at all.</p>{privacySectionsEn.map((section, index) => <section class="legal-section"><span class="legal-number">0{index + 1}</span><div><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></section>)}</div></section></Layout>
