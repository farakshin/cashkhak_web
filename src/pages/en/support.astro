import Layout from "../../components/Layout.astro";
---
<Layout lang="en" title="Support" currentPath="/en/support/"><section class="page-hero section-shell"><div class="shell narrow-shell"><p class="eyebrow"><span class="eyebrow-dot"></span> We're here</p><h1>Need<br /><em>support?</em></h1><p class="page-lede">Tell us what happened. We'll look into it and reply by email.</p></div></section><section class="section-shell page-content"><div class="shell support-grid"><div class="support-card support-card-main"><span class="support-icon">↗</span><p class="section-kicker">Contact the team</p><h2>One question —<br /><em>one answer.</em></h2><p>Include your iPhone model, iOS version and what you expected to see. It helps us find a solution faster.</p><a class="button button-dark" href="mailto:support@cashkhak.app">Open email <span>↗</span></a></div><div class="support-card"><p class="section-kicker">Good to know</p><h3>Before you write</h3><ul class="simple-list"><li>Make sure your iPhone runs iOS 17 or later.</li><li>To use the widget, add at least one card in the app.</li><li>Check cashback terms in your bank's official app.</li></ul></div></div></section></Layout>
