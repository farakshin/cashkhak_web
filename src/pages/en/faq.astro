---
import Layout from "../../components/Layout.astro";
import FaqList from "../../components/FaqList.astro";
import { faqEn } from "../../data/site-en";
---
<Layout lang="en" title="FAQ" currentPath="/en/faq/"><section class="page-hero section-shell"><div class="shell narrow-shell"><p class="eyebrow"><span class="eyebrow-dot"></span> Support</p><h1>Questions,<br /><em>made simple.</em></h1><p class="page-lede">Short answers to what matters before your first launch.</p></div></section><section class="section-shell page-content"><div class="shell narrow-shell"><FaqList items={faqEn} /><div class="question-box"><div><p class="section-kicker">Still wondering?</p><h2>Write to us.</h2></div><a class="button button-dark" href="mailto:support@cashkhak.app">support@cashkhak.app <span>↗</span></a></div></div></section></Layout>
