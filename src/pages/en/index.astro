---
import Layout from "../../components/Layout.astro";
import PhonePreview from "../../components/PhonePreview.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import FaqList from "../../components/FaqList.astro";
import { featuresEn, faqEn } from "../../data/site-en";
import { withBase } from "../../lib/paths";
---
<Layout lang="en" currentPath="/en/" title="Cashback, at hand" description="Cashkhak keeps cashback categories for all your bank cards in one place.">
  <section class="hero section-shell"><div class="shell hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> A smarter cashback reference</p><h1>Pay<br /><em>smarter.</em></h1><p class="hero-lede">Cashkhak remembers which card gives you more cashback this month. You just pick the right one.</p><div class="hero-actions" id="download"><a class="button button-dark" href="#download">Coming to App Store <span>↗</span></a><a class="text-link" href="#how-it-works">How it works <span>↓</span></a></div><div class="hero-footnote"><span class="tiny-lock">⌁</span> No account · data stays on your device</div></div><div class="hero-visual"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="floating-note floating-note-top"><span>March 2026</span><strong>up to 5%</strong></div><PhonePreview /><div class="floating-note floating-note-bottom"><span class="note-check">✓</span><span>Card selected</span></div></div></div></section>
  <section class="ticker"><div class="ticker-track"><span>CARDS</span><i>✦</i><span>CATEGORIES</span><i>✦</i><span>WIDGET</span><i>✦</i><span>NO ACCOUNT</span><i>✦</i><span>CARDS</span><i>✦</i></div></section>
  <section class="section-shell intro-section" id="how-it-works"><div class="shell intro-grid"><p class="section-kicker">Why it exists</p><div><h2>No more guessing<br />at checkout.</h2><p class="section-lede">Banks change their categories every month. Cashkhak keeps everything together and shows the right card at the right time.</p><a class="text-link text-link-dark" href={withBase("/en/faq.html")}>Learn more <span>↗</span></a></div></div></section>
  <section class="section-shell features-section"><div class="shell"><div class="section-heading-row"><div><p class="section-kicker">Everything that matters</p><h2>Your cards.<br /><em>Your rules.</em></h2></div><span class="section-index">01 — 04</span></div><div class="feature-grid">{featuresEn.map((feature) => <FeatureCard {...feature} />)}</div></div></section>
  <section class="section-shell showcase-section"><div class="shell showcase-grid"><div class="showcase-copy"><p class="section-kicker">Less manual work</p><h2>Screenshot.<br /><em>Done.</em></h2><p class="section-lede">Pick the screen with your bank's cashback terms. Cashkhak finds the categories and percentages so you can review them at a glance.</p><div class="recognition-list"><span><b>01</b> Pick a screenshot</span><span><b>02</b> Review categories</span><span><b>03</b> Get more back</span></div></div><div class="scan-art" aria-hidden="true"><div class="scan-card"><div class="scan-top"><span>Cashback this month</span><span>•••</span></div><div class="scan-title">Your categories</div><div class="scan-row"><span>Restaurants</span><b>5%</b></div><div class="scan-row"><span>Transport</span><b>3%</b></div><div class="scan-row"><span>Pharmacies</span><b>4%</b></div><div class="scan-line"></div><div class="scan-row faded"><span>Selected automatically</span><span>✓</span></div></div><div class="scan-beam"></div><span class="scan-label">recognition</span></div></div></section>
  <section class="section-shell privacy-section"><div class="shell privacy-band"><div class="privacy-symbol">⌁</div><div><p class="section-kicker">Your data is yours</p><h2>Local.<br /><em>Private.</em></h2><p>No accounts, servers or hidden tracking. Cashkhak is a personal tool, not another service that needs to know everything about you.</p></div><a class="button button-light" href={withBase("/en/privacy.html")}>Privacy details <span>↗</span></a></div></section>
  <section class="section-shell faq-preview"><div class="shell narrow-shell"><div class="section-heading-row"><div><p class="section-kicker">Frequently asked</p><h2>Have a question?</h2></div><a class="text-link text-link-dark" href={withBase("/en/faq.html")}>All questions <span>↗</span></a></div><FaqList items={faqEn.slice(0, 3)} /></div></section>
  <section class="section-shell final-cta" id="download"><div class="shell final-cta-inner"><p class="eyebrow"><span class="eyebrow-dot"></span> Cashkhak for iPhone</p><h2>Choose your card<br /><em>with confidence.</em></h2><p>Coming to the App Store. Save this page so you don't miss the launch.</p><a class="button button-light" href="mailto:support@cashkhak.app?subject=Cashkhak%20launch">Remind me about launch <span>↗</span></a></div></section>
</Layout>
