---
import Layout from "../components/Layout.astro";
import FaqList from "../components/FaqList.astro";
import { faq } from "../data/site";
---
<Layout title="Вопросы и ответы" currentPath="/faq.html">
  <section class="page-hero section-shell"><div class="shell narrow-shell"><p class="eyebrow"><span class="eyebrow-dot"></span> Поддержка</p><h1>Вопросы,<br /><em>без лишнего.</em></h1><p class="page-lede">Коротко отвечаем на то, что важно знать о Кэшхаке до первого запуска.</p></div></section>
  <section class="section-shell page-content"><div class="shell narrow-shell"><FaqList items={faq} /><div class="question-box"><div><p class="section-kicker">Не нашли ответ?</p><h2>Напишите нам.</h2></div><a class="button button-dark" href="mailto:farakshin@gmail.com">farakshin@gmail.com <span>↗</span></a></div></div></section>
</Layout>
