---
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { site } from "../data/site";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  lang?: "ru" | "en";
  currentPath?: string;
}

const {
  title = site.name,
  description = site.description,
  lang = "ru",
  currentPath = "/"
} = Astro.props;
const canonicalTitle = title === site.name ? title : `${title} — ${site.name}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09bcb0" />
    <meta name="description" content={description} />
    <title>{canonicalTitle}</title>
    <link rel="icon" href={withBase("/cashkhak-app-icon.png")} type="image/png" />
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
